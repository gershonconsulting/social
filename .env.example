# ─── Database ─────────────────────────────────────────────────────────────────
# Use a managed PostgreSQL (Neon, Supabase, Railway, PlanetScale-compatible, etc.)
DATABASE_URL="postgresql://user:password@host:5432/social_crm?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Production URL: https://social.gershoncrm.com
NEXTAUTH_URL="https://social.gershoncrm.com"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── LinkedIn OAuth ───────────────────────────────────────────────────────────
# App from LinkedIn Developer Portal (developer.linkedin.com)
# Scopes: r_organization_social r_organization_followers rw_organization_admin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_ORGANIZATION_ID=""   # e.g. 12345678

# ─── X / Twitter ─────────────────────────────────────────────────────────────
# App from developer.twitter.com — needs OAuth 2.0 with User Context
# Or a Bearer Token for app-only read access
TWITTER_BEARER_TOKEN=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# ─── Google Business Profile ──────────────────────────────────────────────────
# OAuth2 credentials from Google Cloud Console
# Enable: My Business Account Management API, Business Profile API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# ─── Streak CRM (client-list sync) ────────────────────────────────────────────
# Streak is our CRM in Gmail. /api/admin/streak-sync pulls current clients from
# the Clients pipeline and upserts them into the Client table.
# API key: Gmail → Streak icon → Integrations → create/copy key. Treat as secret.
STREAK_API_KEY=""
# Run GET /api/admin/streak-sync?discover=1 once to find these two values:
STREAK_CLIENT_PIPELINE_KEY=""          # pipelineKey of the Clients/Accounts pipeline
STREAK_CURRENT_STAGE_KEYS=""           # comma-separated stageKeys that mean "current"; blank = all boxes

# ─── App Config ───────────────────────────────────────────────────────────────
APP_URL="https://social.gershoncrm.com"
DEFAULT_TIMEZONE="America/New_York"

# ─── Cloudflare Pages Deployment Notes ────────────────────────────────────────
# Deployment: social.gershoncrm.com → CNAME → gershoncrm-social.pages.dev
#
# Cloudflare Pages settings:
#   Framework preset: Next.js
#   Build command:    npm run build
#   Output directory: .next
#   Node.js version:  20.x
#
# Add all env vars above in:
#   Cloudflare Dashboard → Pages → social-gershoncrm → Settings → Environment Variables
#
# For the database, use Neon (neon.tech) or Supabase — both have free tiers and
# give you a standard PostgreSQL connection string with SSL.
#
# Background jobs (daily sync, follower snapshots):
#   Use Cloudflare Workers Cron Triggers, or an external cron service
#   (cron-job.org, EasyCron) that calls /api/cron/daily-sync with a secret key.
