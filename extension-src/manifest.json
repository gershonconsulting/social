{
  "manifest_version": 3,
  "name": "GershonAI — session cookie capture",
  "version": "0.11.0",
  "description": "Sync Now + daily auto-sync + per-step detailed log. v0.11.0: a workspace token, so one extension can collect for whichever workspace it is pointed at. Paste it from Settings → This computer.",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://fr.linkedin.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://social.gershoncrm.com/*"
  ],
  "background": {
    "service_worker": "gx-boot.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GershonAI — Sync Now",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://social.gershoncrm.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
