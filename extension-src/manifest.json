{
  "manifest_version": 3,
  "name": "Social by Gershon.AI — LinkedIn & X Collector + Publisher",
  "version": "0.20.0",
  "description": "Collects LinkedIn and X posts, and publishes approved posts on LinkedIn and X, for the workspace of whoever is signed in to social.gershon.ai in this browser. Does nothing until then.",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "tts",
    "notifications"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://fr.linkedin.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://social.gershon.ai/*",
    "https://social.gershoncrm.com/*"
  ],
  "background": {
    "service_worker": "gx-boot.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Social by Gershon.AI — Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://fr.linkedin.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "gx-visible.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://social.gershon.ai/*",
        "https://social.gershoncrm.com/*"
      ],
      "js": [
        "gx-bridge.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
